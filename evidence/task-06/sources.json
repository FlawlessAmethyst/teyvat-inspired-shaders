    "metadata": "modLoader = \"javafml\"\nloaderVersion = \"*\"\nlicense = \"LGPL-3.0-only\"\n\n[[mods]]\nmodId = \"iris\"\n\nversion = \"1.8.14-beta.1+mc1.21.1\"\ndisplayName = \"Iris\"\n\nlogoFile = \"iris-logo.png\" #optional\n\nauthors = \"coderbot, IMS212\"\n\ndescription = '''\nIris is a modern shaders mod for Minecraft intended to be compatible with existing OptiFine shader packs.\n'''\n\n[[dependencies.iris]]\nmodId = \"minecraft\"\ntype = \"required\"\nversionRange = \"[1.21,1.21.1)\"\nordering = \"NONE\"\nside = \"CLIENT\"\n\n[[mixins]]\nconfig = \"mixins.iris.json\"\n\n[[mixins]]\nconfig = \"mixins.iris.fantastic.json\"\n\n[[mixins]]\nconfig = \"mixins.iris.vertexformat.json\"\n\n[[mixins]]\nconfig = \"iris-batched-entity-rendering.mixins.json\"\n\n[[mixins]]\nconfig = \"mixins.iris.compat.sodium.json\"\n\n[[mixins]]\nconfig = \"mixins.iris.compat.dh.json\"\n\n[[mixins]]\nconfig = \"mixins.iris.forge.json\"\n\n[mods.\"sodium:options\"]\n\"mixin.features.render.world.sky\" = false\n\n[[dependencies.iris]]\nmodId = \"embeddium\"\ntype = \"incompatible\"\nreason = \"Iris and Embeddium cannot be used together. Please use Sodium 0.8 instead.\"\nversionRange = \"[0.0.1,)\"\nordering = \"NONE\"\nside = \"CLIENT\"\n\n[modproperties.iris]\n\"sodium:config_api_user\" = \"net.irisshaders.iris.compat.sodium.config.IrisConfig\"\n",
